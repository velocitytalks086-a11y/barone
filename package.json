{
  "name": "barone",
  "version": "0.1.0",
  "private": true,
  "description": "BarONE - worship multitracks platform (browser based, offline capable)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch --serve",
    "start": "node server/serve.mjs",
    "relay": "node server/relay.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node build.mjs && node --test tests/"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "esbuild": "^0.25.0", "playwright": "^1.56.0", "typescript": "^5.6.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0" }
}
